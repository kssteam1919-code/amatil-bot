import os
import asyncio
import json
from aiogram import Bot, Dispatcher, types, F
from aiogram.filters import CommandStart
from aiohttp import web

TOKEN = "8814200479:AAHp7YU76RZ8ZhkWzWsIPF7x9gWDlv0mC-4"
MY_ID = 8389699824  # число

bot = Bot(token=TOKEN)
dp = Dispatcher()

async def handle(request):
    return web.Response(text="Bot is running")

@dp.message(CommandStart())
async def start(message: types.Message):
    await message.answer("Привет! Открой магазин через кнопку Меню 👇")

# Временный обработчик ВСЕХ сообщений, чтобы увидеть, что приходит
@dp.message()
async def debug_all_messages(message: types.Message):
    # Выводим в логи всё, что получаем
    print(f"=== ВХОДЯЩЕЕ СООБЩЕНИЕ ===")
    print(f"Тип контента: {message.content_type}")
    print(f"Текст: {message.text}")
    print(f"WebAppData: {message.web_app_data}")
    print(f"=========================")

    # Если есть данные веб-приложения – обрабатываем
    if message.web_app_data:
        data = json.loads(message.web_app_data.data)
        order = data['order']
        total = data['total']
        text = "🛒 Новый заказ!\n\n"
        for item in order:
            text += f"• {item['name']} x{item['qty']} — {item['price']}₽\n"
        text += f"\n💰 Итого: {total}₽"
        await bot.send_message(MY_ID, text)
        await message.answer("✅ Заказ принят! Скоро свяжусь с вами.")
    else:
        await message.answer("Я пока не умею отвечать на это 😢")

async def main():
    app = web.Application()
    app.router.add_get('/', handle)
    runner = web.AppRunner(app)
    await runner.setup()
    port = int(os.environ.get('PORT', 8080))
    site = web.TCPSite(runner, '0.0.0.0', port)
    await site.start()
    await dp.start_polling(bot)

if __name__ == '__main__':
    asyncio.run(main())